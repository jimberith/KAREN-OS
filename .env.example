# AI provider settings. Never commit real credentials.
KAREN_AI_API_KEY=
KAREN_AI_BASE_URL=https://api.openai.com/v1
KAREN_AI_MODEL=

# Required to protect a publicly hosted browser application.
# Use a long, unique password. Do not reuse your API key here.
KAREN_ACCESS_PASSWORD=

# Local CLI history directory; blank uses the platform default.
KAREN_DATA_DIR=

# Optional speech output for the local CLI.
KAREN_TTS_ENABLED=false

KAREN_LOG_LEVEL=INFO
