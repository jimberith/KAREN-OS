# AI provider configuration.
# Default is OpenAI. For Gemini, Groq, or OpenRouter, set all three values:
KAREN_AI_API_KEY=
KAREN_AI_BASE_URL=https://api.openai.com/v1
KAREN_AI_MODEL=

# Optional app-level password for public hosting only.
KAREN_ACCESS_PASSWORD=

# Local data directory
KAREN_DATA_DIR=

# Optional speech output for local CLI
KAREN_TTS_ENABLED=false

KAREN_LOG_LEVEL=INFO
