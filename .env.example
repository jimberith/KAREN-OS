# AI provider key and model. Gemini is the recommended provider for KAREN vision/image tools.
KAREN_AI_API_KEY=
KAREN_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
KAREN_AI_MODEL=gemini-3.8-flash
KAREN_GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
KAREN_IMAGE_MODEL=gemini-3.1-flash-image
KAREN_TTS_MODEL=gemini-3.8-flash-lite-tts
KAREN_TTS_VOICE=Kore

# Optional public-hosting password (not required in private Codespaces).
KAREN_ACCESS_PASSWORD=
KAREN_REQUIRE_ACCESS_CODE=false

# Persistent local database and generated images.
KAREN_DATA_DIR=

# Local companion agent. The agent generates a private token on first launch.
KAREN_LOCAL_AGENT_TOKEN=

KAREN_LOG_LEVEL=INFO
