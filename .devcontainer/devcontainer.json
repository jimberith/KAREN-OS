{
  "name": "KAREN OS Python Development",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -e '.[dev,web,agent]'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "remoteUser": "vscode",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "KAREN OS Web",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  }
}
